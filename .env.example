# RevertProof Local Configuration
# Never commit real credentials or production database URLs.

# Database URL:
# - Leave unset or use sqlite:///:memory: for zero-dependency local testing
# - Use postgresql://rp_tester:rp_local_dev_only@localhost:54329/revertproof_test for Docker PostgreSQL
# - In AWS CodeBuild, credentials are loaded from AWS Secrets Manager (RP_AWS_SECRET_ID)
RP_DATABASE_URL=sqlite:///:memory:
RP_DB_SCHEMA=rp_demo
RP_REPORT_DIR=reports
RP_LOG_LEVEL=INFO

# Optional AWS Integration (leave blank for local-only mode)
RP_AWS_REGION=us-east-1
RP_AWS_SECRET_ID=
RP_AWS_S3_BUCKET=
RP_AWS_CLOUDWATCH_NAMESPACE=RevertProof
